# ASODITECH — Production environment variables
#
# This file documents every environment variable this codebase actually
# reads, for a PRODUCTION (Vercel) deployment specifically. It is generated
# from an audit of src/lib/env.ts, prisma.config.ts and every
# `process.env.*` / `env.*` call site in src/ and scripts/ — see
# docs/CLIENT-ENVIRONMENT-VARIABLES.md for the full table (purpose, where
# to obtain each value, secret/public, required/optional) and
# docs/CLIENT-DEPLOYMENT-RUNBOOK.md for how each one is used end to end.
#
# NEVER commit a copy of this file with real values filled in. Set these
# in Vercel → Project → Settings → Environment Variables, one deployment
# (= one client, in the dedicated model) at a time.
#
# tests/lib/deployment-docs-coverage.test.ts fails the test suite if a new
# environment variable is added to src/lib/env.ts (or the other known
# runtime-config call sites) without also being added here and to
# docs/CLIENT-ENVIRONMENT-VARIABLES.md — keep the three in sync.

# ============================================================================
# REQUIRED — next build (via `vercel-build`: `prisma migrate deploy && next
# build`) fails while collecting routes without these four.
# ============================================================================

# Pooled Postgres connection (Supabase: port 6543 / PgBouncer, "Transaction"
# mode). Append `?pgbouncer=true` — required so Prisma disables prepared
# statements, which don't survive transaction-pooling mode. In production
# this MUST be the restricted, non-superuser, NOBYPASSRLS runtime role (see
# scripts/provision-production-role.sql and
# docs/adr/0026-multi-tenant-rls.md) — Postgres Row-Level Security enforces
# nothing for a superuser or the table owner.
DATABASE_URL="postgresql://asoditech_app:REPLACE_ME@db.<project-ref>.supabase.co:6543/postgres?schema=public&pgbouncer=true"

# Direct (unpooled) Postgres connection, used only by
# `prisma migrate deploy` to run DDL (see the `vercel-build` script in
# package.json). In production this MUST be the DATABASE OWNER/admin role
# (never the restricted runtime role above — it cannot run DDL), on the
# direct port (Supabase: 5432, not 6543).
DIRECT_URL="postgresql://postgres:REPLACE_ME@db.<project-ref>.supabase.co:5432/postgres?schema=public"

# Pepper mixed into session-token hashing (src/lib/auth/session.ts,
# src/lib/auth/tokens.ts). Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session (forces re-login) —
# it does NOT affect stored passwords (bcrypt, unrelated).
AUTH_SECRET="REPLACE_ME_openssl_rand_base64_32"

# 32-byte key (base64), AES-256-GCM, used to encrypt every integration
# credential at rest (src/lib/crypto.ts) — WooCommerce/Shopify API keys,
# OzonExpress/Aramex delivery credentials, Google Drive OAuth tokens.
# Generate with: openssl rand -base64 32
# Losing this key makes every stored credential undecryptable — every
# integration in this deployment would need to be reconnected from scratch.
# Never rotate it casually; there is no re-encryption tool.
INTEGRATION_ENCRYPTION_KEY="REPLACE_ME_openssl_rand_base64_32"

# ============================================================================
# STRONGLY RECOMMENDED — has a code default that is WRONG in production.
# ============================================================================

# Canonical public base URL of this deployment. Used to build absolute
# links in transactional emails (src/lib/email.ts — invitations, password
# resets, support-ticket forwards) and the Google Drive OAuth redirect URI
# (`${APP_URL}/parametres/sauvegarde/google/callback`). Defaults to
# http://localhost:3000 if unset — a deployed environment left on the
# default will send broken links. Use the real domain, never a
# *.vercel.app preview URL (it changes per deployment).
APP_URL="https://app.votre-client.com"

# ============================================================================
# OPTIONAL — each feature below is fully inert (safe, documented fallback)
# when its variables are unset. Set only the ones this client needs.
# ============================================================================

# --- Transactional email (Resend) — src/lib/email.ts -----------------------
# Invitations, password resets, and support-widget "signaler un problème"
# forwards. Unset ⇒ every send is logged to the server console instead of
# actually delivered (safe default, not an error). Get a key at
# https://resend.com; EMAIL_FROM must be a sender verified on that Resend
# account/domain.
RESEND_API_KEY=""
EMAIL_FROM="ASODITECH <noreply@votre-client.com>"

# --- Backup & Portability — src/lib/backup/container.ts --------------------
# (docs/adr/0034-backup-and-portability.md). 32-byte base64 key, same
# format as INTEGRATION_ENCRYPTION_KEY. OPTIONAL: unset ⇒ the backup module
# reuses INTEGRATION_ENCRYPTION_KEY. A deployment that relies on backups
# SHOULD set a distinct key and MUST keep a copy of it OUTSIDE the
# database — a lost key makes every existing `.asb` package permanently
# unrecoverable (there is no re-encryption/recovery tool). Generate with:
# openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=""

# --- Backup Phase 2: Google Drive as a backup destination -------------------
# (docs/adr/0034 §"Phase 2"). BOTH optional together: unset ⇒ the "Google
# Drive" section of Réglages → Sauvegarde shows "non configuré" and every
# Drive code path is inert. Create an OAuth 2.0 "Web application" client in
# Google Cloud Console (scope drive.file), and register the redirect URI
# "${APP_URL}/parametres/sauvegarde/google/callback" as an Authorized
# redirect URI on that client.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Shopify integration kill switch ----------------------------------------
# (src/lib/integrations/shopify/feature-flag.ts). The Shopify adapter is
# fully built but DISABLED BY DEFAULT (shown as "Bientôt disponible" in
# Intégrations) — this is a deliberate product decision (client feedback
# #10), not a bug. Existing Shopify connections keep receiving webhooks
# even while disabled; only new connect/configure/sync actions are
# refused. Set to the literal string "true" (any other value, including
# unset, means disabled) only for a client that should have Shopify.
SHOPIFY_INTEGRATION_ENABLED="false"

# ============================================================================
# SET BY THE PLATFORM — do not set manually in Vercel's dashboard.
# ============================================================================

# Vercel sets this to "production" / "preview" / "development" per
# environment automatically. Only relevant to set by hand for local dev
# (.env) or the test suite (.env.test, forced to "test").
NODE_ENV="production"

# ============================================================================
# NOT a Vercel project variable — used ONCE, from an operator's own
# machine, to create the first OWNER account against the production
# database. See docs/CLIENT-DEPLOYMENT-RUNBOOK.md §8 (First admin/owner).
# Do NOT add these two to the Vercel project's Environment Variables —
# the deployed app never reads them at runtime.
# ============================================================================
# SEED_OWNER_EMAIL="owner@votre-client.com"
# SEED_OWNER_PASSWORD="REPLACE_ME_a_real_strong_password"

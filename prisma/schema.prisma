// ASODITECH E-commerce Management System — core domain schema.
// See docs/adr/ for the reasoning behind these boundaries.
//
// Multi-tenancy:
//  - Phase 1 (docs/adr/0023-multi-tenant-foundation.md) — every business/data
//    model carries a `tenantId` FK to `Tenant`, defaulted to the bootstrap
//    tenant ("default").
//  - Phase 2 (docs/adr/0024-multi-tenant-context.md) — request-scoped tenant
//    context + a Prisma client extension enforce isolation at the app layer.
//  - Phase 3 (docs/adr/0025-multi-tenant-isolation.md) — the composite
//    tenant-scoped unique constraints below (replacing the Phase 1 global
//    ones), a tenant-scoped BusinessSettings, and per-tenant DISPLAY
//    numbering for orders/transfers/stocktakes (Tenant.nextOrderNumber and
//    friends; Order.displayNumber and friends) layered on top of the
//    untouched, never-renumbered global sequences.
// Postgres RLS (Phase 4) is still not in place — isolation today is
// entirely application-level (the Phase 2 extension + these constraints).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the pooled connection (PgBouncer) used by the app at
// runtime; DIRECT_URL is the unpooled connection Prisma Migrate needs for
// DDL. Locally both can point at the same local Postgres instance.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenant — Phase 1 multi-tenant foundation (docs/adr/0023-multi-tenant-foundation.md)
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// One workspace / client company. Phase 1 seeds exactly one row with the
// fixed id "default" (the same well-known-singleton pattern as
// BusinessSettings.id = "singleton"), and every tenant-scoped column
// defaults to it — so this table exists and is wired, but no code reads it
// yet. Later phases add tenant resolution, query scoping and provisioning.
model Tenant {
  id        String       @id @default("default")
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Per-tenant DISPLAY numbering (Phase 3 — docs/adr/0025-multi-tenant-isolation.md).
  // The next value to hand out for Order.displayNumber / StockTransfer.displayNumber /
  // StocktakeSession.displayNumber. Deliberately separate from the historical
  // orderNumber/transferNumber/sessionNumber autoincrement columns, which are
  // NEVER renumbered or reused — those stay a single global sequence across
  // every tenant, forever, as the immutable internal identity. Claimed
  // atomically via a row-locked `UPDATE … SET x = x + 1` (see
  // src/lib/tenant/numbering.ts) — safe under concurrent creates for the
  // same tenant. Backfilled by the Phase 3 migration to
  // MAX(existing global number for this tenant's rows) + 1, so the
  // bootstrap tenant's next display number continues seamlessly from
  // exactly where the old global sequence left off.
  nextOrderNumber     Int @default(1)
  nextTransferNumber  Int @default(1)
  nextStocktakeNumber Int @default(1)

  users                     User[]
  customers                 Customer[]
  customerAddresses         CustomerAddress[]
  categories                Category[]
  products                  Product[]
  productImages             ProductImage[]
  productVariations         ProductVariation[]
  warehouses                Warehouse[]
  inventoryItems            InventoryItem[]
  inventoryMovements        InventoryMovement[]
  stockTransfers            StockTransfer[]
  stockTransferLines        StockTransferLine[]
  stocktakeSessions         StocktakeSession[]
  stocktakeLines            StocktakeLine[]
  orders                    Order[]
  orderItems                OrderItem[]
  orderConfirmationAttempts OrderConfirmationAttempt[]
  refunds                   Refund[]
  commissionAgents          CommissionAgent[]
  commissionEntries         CommissionEntry[]
  commissionStatements      CommissionStatement[]
  shippingProviders         ShippingProvider[]
  deliveryCityMappings      DeliveryCityMapping[]
  shipments                 Shipment[]
  deliveryManifests         DeliveryManifest[]
  shipmentWebhookEvents     ShipmentWebhookEvent[]
  expenseCategories         ExpenseCategory[]
  expenses                  Expense[]
  marketingChannels         MarketingChannel[]
  marketingCampaigns        MarketingCampaign[]
  integrations              Integration[]
  syncRuns                  SyncRun[]
  webhookEvents             WebhookEvent[]
  notifications             Notification[]
  businessSettings          BusinessSettings[]
  auditEvents               AuditEvent[]
  invitations               Invitation[]
  passwordResetTokens       PasswordResetToken[]
  backupRuns                BackupRun[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Auth & RBAC — see docs/adr/0003-auth-and-rbac.md
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  // Order-confirmation agent (confirmateur) — see
  // docs/adr/0022-order-confirmation-commission.md. Renamed from SALES in
  // Phase 5 (docs/adr/0027-tenant-provisioning.md) to match what the role
  // actually does in this app; `ALTER TYPE … RENAME VALUE` in the
  // migration preserves every existing row's role unchanged.
  CONFIRMATION
  WAREHOUSE
  DELIVERY
  SUPPORT
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(cuid())
  tenantId        String     @default("default")
  email           String
  name            String
  passwordHash    String
  role            UserRole   @default(CONFIRMATION)
  status          UserStatus @default(ACTIVE)
  // Cross-tenant flag, deliberately NOT part of the per-tenant RBAC matrix
  // (docs/adr/0003) — grants access to the `/platform` area (Phase 5,
  // docs/adr/0027-tenant-provisioning.md), which manages OTHER tenants'
  // existence. Independent of `role`: a platform admin is still a normal
  // member of their own tenant otherwise. Never settable through any
  // tenant-scoped action — only by direct DB access (this app's answer to
  // "who provisions the provisioner" while there is no billing/licensing
  // layer yet).
  isPlatformAdmin Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?

  tenant                     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions                   Session[]
  invitationsSent            Invitation[]               @relation("InvitationInvitedBy")
  invitationAccepted         Invitation?                @relation("InvitationAcceptedUser")
  passwordResetTokens        PasswordResetToken[]
  customersCreated           Customer[]                 @relation("CustomerCreatedBy")
  ordersCreated              Order[]                    @relation("OrderCreatedBy")
  productsCreated            Product[]                  @relation("ProductCreatedBy")
  warehousesCreated          Warehouse[]                @relation("WarehouseCreatedBy")
  inventoryMovements         InventoryMovement[]        @relation("MovementPerformedBy")
  expensesRecorded           Expense[]                  @relation("ExpenseRecordedBy")
  shipmentsUpdated           Shipment[]                 @relation("ShipmentUpdatedBy")
  manifestsCreated           DeliveryManifest[]         @relation("ManifestCreatedBy")
  syncRunsTriggered          SyncRun[]                  @relation("SyncRunTriggeredBy")
  auditEvents                AuditEvent[]               @relation("AuditActorUser")
  notifications              Notification[]
  stockTransfersCreated      StockTransfer[]            @relation("StockTransferCreatedBy")
  stockTransfersDispatched   StockTransfer[]            @relation("StockTransferDispatchedBy")
  stockTransfersReceived     StockTransfer[]            @relation("StockTransferReceivedBy")
  stocktakesStarted          StocktakeSession[]         @relation("StocktakeStartedBy")
  stocktakesClosed           StocktakeSession[]         @relation("StocktakeClosedBy")
  stocktakesCounted          StocktakeLine[]            @relation("StocktakeCountedBy")
  commissionAgent            CommissionAgent?
  commissionStatementsClosed CommissionStatement[]      @relation("CommissionStatementClosedBy")
  commissionStatementsPaid   CommissionStatement[]      @relation("CommissionStatementPaidBy")
  confirmationAttempts       OrderConfirmationAttempt[] @relation("ConfirmationAttemptAgent")
  backupRunsCreated          BackupRun[]                @relation("BackupRunCreatedBy")

  // Phase 3 (docs/adr/0025): email is unique PER TENANT, not globally — two
  // tenants may have a user with the same email. Login (src/actions/auth.ts)
  // looks up every candidate across tenants and disambiguates by password.
  @@unique([tenantId, email])
  @@index([role])
  @@index([tenantId])
  @@map("users")
}

// Opaque, server-verified session tokens (see docs/adr/0003).
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenant-scoped user provisioning — Phase 5 (docs/adr/0027-tenant-provisioning.md).
// Both models use the same secure-token mechanism as Session (src/lib/auth/
// tokens.ts, shared with session.ts): a random 256-bit token handed to the
// invitee/requester, only its HMAC-SHA256 hash ever stored. Lookup happens
// BEFORE any tenant is known (like login's email lookup), so `tokenHash` is
// globally unique — never a composite with tenantId, the one deliberate
// exception to Phase 3's "no more global uniqueness" — the token itself is
// the lookup key precisely because the tenant isn't known yet.
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// One pending (or resolved) invite for a specific email to join a specific
// tenant at a specific role. Creating a User row directly (a temporary
// admin-chosen password) is gone — every user, in every tenant, including a
// brand-new tenant's first OWNER (see `createTenantAction`), is provisioned
// by accepting one of these. At most one PENDING invitation per
// (tenant, email) — `inviteUserAction` revokes any prior pending one for
// the same address rather than allowing two live tokens for one invite.
model Invitation {
  id         String           @id @default(cuid())
  tenantId   String           @default("default")
  email      String
  name       String
  role       UserRole
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  invitedById  String?
  acceptedById String? @unique

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy  User?  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?  @relation("InvitationAcceptedUser", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@map("invitations")
}

// A one-time password-reset link for an EXISTING user. `usedAt` makes it
// single-use; `expiresAt` is deliberately much shorter-lived than an
// Invitation's (1 hour vs 7 days) — resetting an active account's password
// is more sensitive than onboarding a new one.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String    @default("default")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

enum CustomerSegment {
  NOUVEAU
  ACTIF
  FIDELE
  A_RISQUE
  INACTIF
  VIP
}

model Customer {
  id              String           @id @default(cuid())
  tenantId        String           @default("default")
  fullName        String
  phone           String?
  whatsapp        String?
  email           String?
  city            String?
  region          String?
  country         String           @default("Maroc")
  notes           String?
  tags            String[]         @default([])
  // Manually assigned only — no automatic segmentation logic exists yet.
  // See docs/adr/0002-domain-model.md.
  segment         CustomerSegment?
  // Staff-controlled flag (see docs/adr/0002-domain-model.md) — never set
  // automatically by a threshold: the Clients page/order form surface how
  // many orders a customer has cancelled so staff can decide, but only a
  // human toggles this, to avoid locking out a customer who had a
  // legitimate reason (e.g. a shipping delay, a genuine change of mind).
  isBlacklisted   Boolean          @default(false)
  blacklistedAt   DateTime?
  blacklistReason String?
  // Set only when this customer was created/matched from a WooCommerce
  // order import (see docs/adr/0010-woocommerce-integration.md). Deduped by
  // (source, externalId) when the order carries a real WC customer id, or
  // by (source, email) for guest checkouts — never by fuzzy name matching.
  source          RecordSource     @default(INTERNE)
  externalId      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdById String?
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  addresses   CustomerAddress[]
  orders      Order[]

  @@index([createdAt])
  @@index([source, externalId])
  @@index([tenantId])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  region       String?
  country      String   @default("Maroc")
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([tenantId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Products, categories, variations
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIF
  BROUILLON
  ARCHIVE
}

// Origin of the record — internal management is the default; the others
// exist so a future WooCommerce/Shopify adapter has somewhere to write
// mapped products without changing this schema (see docs/adr/0004).
enum RecordSource {
  INTERNE
  WOOCOMMERCE
  SHOPIFY
}

// Where a manually-created (source=INTERNE) order actually came from —
// distinct from `source`, which only distinguishes "synced from a
// connected store" vs "entered by hand" here. A WOOCOMMERCE/SHOPIFY order
// derives its display channel from `source` itself; `channel` is null on
// those and only ever set on an INTERNE order via the order form.
enum OrderChannel {
  TELEPHONE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  SITE_WEB
  AUTRE
}

model Category {
  id          String       @id @default(cuid())
  tenantId    String       @default("default")
  name        String
  slug        String
  description String?
  parentId    String?
  source      RecordSource @default(INTERNE)
  externalId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Phase 3 (docs/adr/0025): slug is unique per tenant, not globally.
  @@unique([tenantId, slug])
  @@index([source, externalId])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                String        @id @default(cuid())
  tenantId          String        @default("default")
  name              String
  sku               String
  description       String?
  categoryId        String?
  price             Decimal       @db.Decimal(12, 2)
  salePrice         Decimal?      @db.Decimal(12, 2)
  cost              Decimal?      @db.Decimal(12, 2)
  status            ProductStatus @default(BROUILLON)
  trackInventory    Boolean       @default(true)
  lowStockThreshold Int           @default(5)
  source            RecordSource  @default(INTERNE)
  externalId        String?
  // When the product first came into existence for the merchant: the
  // platform's own `date_created` / `createdAt` for an imported product,
  // and `now()` for one created here. `createdAt` below is only the local
  // row's insert time (i.e. when a sync first saw it), which is useless
  // for "newest products first" — the catalogue list sorts on this.
  // Backfilled to `createdAt` for pre-existing rows; the next sync
  // overwrites imported rows with the true platform date.
  platformCreatedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  createdById    String?
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy      User?               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variations     ProductVariation[]
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  transferLines  StockTransferLine[]

  // Phase 3 (docs/adr/0025): sku is unique per tenant, not globally.
  @@unique([tenantId, sku])
  @@index([categoryId])
  @@index([status])
  @@index([source, externalId])
  @@index([tenantId])
  @@index([tenantId, platformCreatedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([tenantId])
  @@map("product_images")
}

model ProductVariation {
  id         String       @id @default(cuid())
  tenantId   String       @default("default")
  productId  String
  sku        String
  // e.g. { "Couleur": "Rouge", "Taille": "M" }
  attributes Json
  price      Decimal?     @db.Decimal(12, 2)
  cost       Decimal?     @db.Decimal(12, 2)
  source     RecordSource @default(INTERNE)
  externalId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  transferLines  StockTransferLine[]

  // Phase 3 (docs/adr/0025): sku is unique per tenant, not globally.
  @@unique([tenantId, sku])
  @@index([productId])
  @@index([source, externalId])
  @@index([tenantId])
  @@map("product_variations")
}

// ---------------------------------------------------------------------------
// Inventory — see docs/adr/0005-inventory-and-sync.md
// ---------------------------------------------------------------------------

// A physical stock location. `type` distinguishes a back-office warehouse
// (ENTREPOT) from a retail store (MAGASIN) — both hold stock through the
// same per-`(warehouse, product|variation)` InventoryItem rows, so this is
// the ONE location entity (no separate Store/Location model — see
// docs/adr/0019-inventory-foundation.md, Phase 32a). `isActive` lets a
// location be retired without deleting its inventory history
// (`InventoryItem.warehouse` is onDelete: Restrict).
enum WarehouseType {
  ENTREPOT
  MAGASIN
}

model Warehouse {
  id          String        @id @default(cuid())
  tenantId    String        @default("default")
  name        String
  isDefault   Boolean       @default(false)
  type        WarehouseType @default(ENTREPOT)
  // A retired location keeps its InventoryItem history but can no longer
  // receive new stock-in movements (manual adjustments) — enforced
  // server-side. The `isDefault` warehouse can never be deactivated.
  isActive    Boolean       @default(true)
  address     String?
  // Set when this warehouse represents a real Shopify Location — see
  // docs/adr/0011-shopify-integration.md. Shopify tracks inventory
  // per-location; mapping each Location to its own Warehouse (rather than
  // collapsing to one number) lets the existing per-warehouse
  // InventoryItem model represent it faithfully, unlike WooCommerce (which
  // has no location concept and only ever uses the single default
  // warehouse).
  source      RecordSource  @default(INTERNE)
  externalId  String?
  createdAt   DateTime      @default(now())
  createdById String?

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy         User?               @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  inventoryItems    InventoryItem[]
  movements         InventoryMovement[]
  fulfilledOrders   Order[]             @relation("OrderFulfillmentWarehouse")
  transfersOut      StockTransfer[]     @relation("StockTransferSource")
  transfersIn       StockTransfer[]     @relation("StockTransferDestination")
  stocktakeSessions StocktakeSession[]

  @@index([source, externalId])
  @@index([isActive])
  @@index([tenantId])
  @@map("warehouses")
}

// Current-state cache: one row per (warehouse, product) or (warehouse,
// variation). Kept in sync with InventoryMovement inserts inside the same
// transaction — movements are the append-only source of truth, this table
// exists purely so list/detail pages don't have to sum movements on every
// read.
//
// DB-enforced invariant (not expressible in Prisma's schema DSL on the
// 6.19.2 line, added via a raw-SQL migration — see
// prisma/migrations/20260821020000_inventory_item_exactly_one_ref_check):
// exactly one of productId/variationId must be set, never both, never
// neither.
model InventoryItem {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  warehouseId        String
  productId          String?
  variationId        String?
  quantityOnHand     Int       @default(0)
  quantityReserved   Int       @default(0)
  quantityDamaged    Int       @default(0)
  // Shopify's own InventoryItem gid at this (product/variant, location)
  // pair — a distinct resource from the Product/ProductVariation gid, and
  // exactly what the inventorySetQuantities mutation requires as its
  // target. Null for INTERNE/WooCommerce-backed rows (WooCommerce's stock
  // API targets by product/variation id directly, no separate inventory
  // item concept). See docs/adr/0011-shopify-integration.md.
  externalId         String?
  // Echo-loop guard for the automatic System → WooCommerce/Shopify stock
  // push (see pushStockAfterLocalChange / reconcileStockFromProvider):
  // the sellable quantity this app itself last told the store, and when.
  // When an inbound stock webhook/pull reports exactly this quantity
  // shortly after, it's almost certainly this app's own push echoing
  // back — not a genuine external change — and reconciling it as one
  // would misapply the store's *sellable* number (on-hand minus reserved)
  // as if it were the new raw on-hand quantity, silently losing whatever
  // was reserved. Null until the first push.
  lastPushedQuantity Int?
  lastPushedAt       DateTime?
  updatedAt          DateTime  @updatedAt

  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product        Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation      ProductVariation?   @relation(fields: [variationId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  stocktakeLines StocktakeLine[]

  @@unique([warehouseId, productId])
  @@unique([warehouseId, variationId])
  @@index([productId])
  @@index([variationId])
  @@index([tenantId])
  @@map("inventory_items")
}

enum InventoryMovementType {
  RECEPTION
  VENTE
  RETOUR
  ENDOMMAGE
  AJUSTEMENT_POSITIF
  AJUSTEMENT_NEGATIF
  RESERVATION
  LIBERATION
  // Stock leaving a source warehouse on a StockTransfer dispatch, and
  // arriving at the destination on receive (Phase 32b — see
  // docs/adr/0020-stock-transfers.md). Both carry `stockTransferId`.
  TRANSFERT_SORTIE
  TRANSFERT_ENTREE
  // Reconciliation of a physical stock count against the system quantity
  // at stocktake finalization (Phase 32c — see
  // docs/adr/0021-stocktaking.md). Carries `stocktakeSessionId`; the
  // signed variance drives on-hand, and only non-zero variances create a row.
  INVENTAIRE
}

model InventoryMovement {
  id                 String                @id @default(cuid())
  tenantId           String                @default("default")
  inventoryItemId    String
  // The location whose stock this movement changed — always the
  // `InventoryItem.warehouseId` of the row it was applied to (Phase 32b),
  // persisted so per-location ledger queries never re-join. NOT NULL:
  // every movement has always been applied to an InventoryItem
  // (`inventoryItemId` NOT NULL, onDelete Cascade → no orphan possible),
  // so the one-time backfill from `inventory_items.warehouseId` was total.
  warehouseId        String
  type               InventoryMovementType
  quantity           Int
  reason             String?
  orderId            String?
  // Set on the two TRANSFERT_* movements a StockTransfer produces; null
  // for every other movement type. `SetNull` so an admin cleanup of a
  // transfer would not cascade its ledger rows.
  stockTransferId    String?
  // Set on the INVENTAIRE movement a stocktake finalization produces for a
  // non-zero variance line (Phase 32c). `SetNull` for the same reason.
  stocktakeSessionId String?
  performedById      String?
  createdAt          DateTime              @default(now())

  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stockTransfer    StockTransfer?    @relation(fields: [stockTransferId], references: [id], onDelete: SetNull)
  stocktakeSession StocktakeSession? @relation(fields: [stocktakeSessionId], references: [id], onDelete: SetNull)
  // Inverse of StocktakeLine.appliedMovement — at most one stocktake line
  // binds a given movement (StocktakeLine.appliedMovementId is @unique).
  stocktakeLine    StocktakeLine?    @relation("StocktakeLineMovement")
  performedBy      User?             @relation("MovementPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([createdAt])
  // Movement history for one item, newest first — the per-item ledger view.
  @@index([inventoryItemId, createdAt])
  // Movements at one location over time — the per-warehouse ledger view.
  @@index([warehouseId, createdAt])
  @@index([stockTransferId])
  @@index([stocktakeSessionId])
  @@index([tenantId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Stock transfers — Phase 32b (docs/adr/0020-stock-transfers.md).
// Move units between two InventoryItem locations through an explicit,
// auditable lifecycle. No reservation, no split fulfilment, no in-transit
// stock bucket: dispatch removes the sent quantity from the source
// (TRANSFERT_SORTIE), receive adds the received quantity to the
// destination (TRANSFERT_ENTREE); a shortfall shows only as the delta
// between the two movements.
// ---------------------------------------------------------------------------

enum TransferStatus {
  BROUILLON
  EN_TRANSIT
  RECU
  ANNULE
}

model StockTransfer {
  id                     String         @id @default(cuid())
  tenantId               String         @default("default")
  // Sequential, collision-free, GLOBAL (never per-tenant) internal identity —
  // never renumbered, never shown to a user. Same pattern as Order.orderNumber.
  transferNumber         Int            @unique @default(autoincrement())
  // Per-tenant DISPLAY number (Phase 3 — docs/adr/0025), shown as
  // "TR-000123" (formatTransferNumber) instead of transferNumber. Null for
  // every pre-Phase-3 row — formatTransferNumber falls back to
  // transferNumber for those. Assigned atomically at creation via
  // src/lib/tenant/numbering.ts.
  displayNumber          Int?
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 TransferStatus @default(BROUILLON)
  notes                  String?
  createdById            String?
  dispatchedById         String?
  dispatchedAt           DateTime?
  receivedById           String?
  receivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // A warehouse with transfer history can't be deleted (it also holds
  // InventoryItem rows — onDelete: Restrict there too).
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  source       Warehouse           @relation("StockTransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destination  Warehouse           @relation("StockTransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedBy User?               @relation("StockTransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy   User?               @relation("StockTransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  lines        StockTransferLine[]
  movements    InventoryMovement[]

  // DB-enforced (raw-SQL migration): source and destination must differ.
  // Postgres allows multiple NULLs, so every pre-Phase-3 row (displayNumber
  // NULL) is unrestricted by this constraint.
  @@unique([tenantId, displayNumber])
  @@index([status])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("stock_transfers")
}

// One product/variation line on a transfer. Exactly one of
// productId/variationId is set at the application level (createStockTransfer
// validates it) — NOT a DB CHECK, because `onDelete: SetNull` on the
// catalogue FKs would make an XOR CHECK fail the moment a product is
// deleted. Mirrors OrderItem exactly. A line whose catalogue record is
// later deleted (both refs null) is safely skipped on receive.
//
// DB-enforced (raw-SQL migration): quantitySent > 0, and quantityReceived
// is either NULL or between 0 and quantitySent inclusive.
model StockTransferLine {
  id               String  @id @default(cuid())
  tenantId         String  @default("default")
  stockTransferId  String
  productId        String?
  variationId      String?
  quantitySent     Int
  quantityReceived Int?

  stockTransfer StockTransfer     @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variation     ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([stockTransferId])
  @@index([productId])
  @@index([variationId])
  @@index([tenantId])
  @@map("stock_transfer_lines")
}

// ---------------------------------------------------------------------------
// Stocktaking — Phase 32c (docs/adr/0021-stocktaking.md).
// Physical stock count for ONE warehouse per session. Counting NEVER
// freezes inventory: updateStocktakeCountsAction writes only StocktakeLine
// columns; InventoryItem.quantityOnHand is untouched until finalization,
// which applies the SIGNED VARIANCE per line through the canonical
// applyStockMovement primitive (never an absolute set). A counted line
// whose current on-hand no longer matches the snapshot taken at count time
// is STALE and blocks finalization until recounted.
// ---------------------------------------------------------------------------

enum StocktakeStatus {
  EN_COURS
  CLOTURE
  ANNULE
}

model StocktakeSession {
  id            String          @id @default(cuid())
  tenantId      String          @default("default")
  // Sequential, collision-free, GLOBAL (never per-tenant) internal identity —
  // never renumbered, never shown to a user. Same pattern as Order.orderNumber.
  sessionNumber Int             @unique @default(autoincrement())
  // Per-tenant DISPLAY number (Phase 3 — docs/adr/0025), shown as
  // "INV-000123" (formatStocktakeNumber) instead of sessionNumber. Null for
  // every pre-Phase-3 row — formatStocktakeNumber falls back to
  // sessionNumber for those. Assigned atomically at creation via
  // src/lib/tenant/numbering.ts.
  displayNumber Int?
  warehouseId   String
  status        StocktakeStatus @default(EN_COURS)
  notes         String?
  startedById   String?
  closedById    String?
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // A warehouse with stocktake history can't be deleted (it also holds
  // InventoryItem rows — onDelete: Restrict there too).
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  startedBy User?               @relation("StocktakeStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  closedBy  User?               @relation("StocktakeClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  lines     StocktakeLine[]
  movements InventoryMovement[]

  // DB-enforced (raw-SQL migration): a PARTIAL unique index on
  // (warehouseId) WHERE status = 'EN_COURS' — at most one open session per
  // warehouse at a time.
  @@unique([tenantId, displayNumber])
  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("stocktake_sessions")
}

// One line per (session, InventoryItem), snapshotted at session creation
// for every InventoryItem in the warehouse (including zero on-hand rows).
//
// State is derived, not a status enum:
//   - countedQuantity IS NULL    → not yet counted (skipped at finalize)
//   - isStale = true             → counted, but on-hand moved since; blocks finalize
//   - appliedAt IS NOT NULL      → processed at finalize (movement, or zero-variance no-op)
//
// `systemQuantityAtCount` is the on-hand value AT THE MOMENT OF COUNTING
// (re-captured on every recount). `isStale` is a UI hint only — finalize
// always re-verifies against the LOCKED current quantity, never this flag.
//
// DB-enforced (raw-SQL migration): countedQuantity IS NULL OR countedQuantity >= 0.
model StocktakeLine {
  id                    String    @id @default(cuid())
  tenantId              String    @default("default")
  stocktakeSessionId    String
  inventoryItemId       String
  systemQuantityAtCount Int
  countedQuantity       Int?
  countedAt             DateTime?
  countedById           String?
  isStale               Boolean   @default(false)
  appliedAt             DateTime?
  appliedMovementId     String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  stocktakeSession StocktakeSession   @relation(fields: [stocktakeSessionId], references: [id], onDelete: Cascade)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Cascade — matches InventoryMovement.inventoryItemId: a deleted
  // product/variation takes its whole stock history (movements + stocktake
  // lines) with it.
  inventoryItem    InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  countedBy        User?              @relation("StocktakeCountedBy", fields: [countedById], references: [id], onDelete: SetNull)
  appliedMovement  InventoryMovement? @relation("StocktakeLineMovement", fields: [appliedMovementId], references: [id], onDelete: SetNull)

  @@unique([stocktakeSessionId, inventoryItemId])
  @@index([stocktakeSessionId])
  @@index([inventoryItemId])
  @@index([tenantId])
  @@map("stocktake_lines")
}

// ---------------------------------------------------------------------------
// Orders — see docs/adr/0002-domain-model.md for the state machine
// ---------------------------------------------------------------------------

enum OrderStatus {
  NOUVELLE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
  RETOUR
  REMBOURSEE
  ECHEC
}

enum OrderPaymentStatus {
  EN_ATTENTE
  PAYE
  PARTIELLEMENT_PAYE
  ECHEC
  REMBOURSE
}

enum PaymentMethod {
  PAIEMENT_LIVRAISON
  VIREMENT_BANCAIRE
  CARTE_BANCAIRE
  MOBILE_MONEY
  AUTRE
}

model Order {
  id             String             @id @default(cuid())
  tenantId       String             @default("default")
  // Sequential, collision-free, GLOBAL (never per-tenant) internal identity —
  // never renumbered. Phase 3 (docs/adr/0025) introduces `displayNumber`
  // below for what's actually shown to a user.
  orderNumber    Int                @unique @default(autoincrement())
  // Per-tenant DISPLAY number, shown as "CMD-000123" (formatOrderNumber)
  // instead of orderNumber. Null for every pre-Phase-3 row —
  // formatOrderNumber falls back to orderNumber for those. Assigned
  // atomically at creation via src/lib/tenant/numbering.ts.
  displayNumber  Int?
  customerId     String
  status         OrderStatus        @default(NOUVELLE)
  paymentStatus  OrderPaymentStatus @default(EN_ATTENTE)
  paymentMethod  PaymentMethod      @default(PAIEMENT_LIVRAISON)
  source         RecordSource       @default(INTERNE)
  externalId     String?
  // WooCommerce's human-readable order "number", which can differ from its
  // numeric id (e.g. a sequential-numbering plugin). Display-only.
  externalNumber String?
  // Set by the order form for a manually-created order (see OrderChannel's
  // own doc comment); null for a WooCommerce/Shopify-imported order and
  // for an INTERNE order created before this field existed.
  channel        OrderChannel?

  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  shippingCost  Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  currency      String  @default("MAD") @db.Char(3)

  // Address + recipient snapshot at time of order — never a live FK, so
  // editing/deleting a customer later cannot rewrite order history. Two
  // WooCommerce orders under one customer account can carry different
  // billing names (a shop reusing a single login), so the name shown for
  // an order is this snapshot, not `customer.fullName`. Null for
  // pre-existing rows → display falls back to the customer.
  shippingName         String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingRegion       String?
  shippingCountry      String?
  shippingPhone        String?

  notes         String?
  internalNotes String?

  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  // Order-confirmation call workflow (docs/adr/0029). Denormalised from
  // `confirmationAttempts` so the shared confirmation queue can sort by
  // "least recently tried" and flag orders past a retry threshold without
  // an aggregate per row.
  confirmationAttemptCount  Int       @default(0)
  lastConfirmationAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // When the customer actually placed the order — WooCommerce/Shopify
  // `date_created` for an imported order, `now()` for a manual one.
  // `createdAt` on an imported order is only when the sync ran, so it is
  // useless for "orders this month" questions: dashboards, the finance
  // period filter and the orders list all sort/filter on this instead.
  placedAt  DateTime @default(now())

  // The warehouse this order's stock movements target (Phase 32b — see
  // docs/adr/0020-stock-transfers.md). Set at creation to
  // getDefaultWarehouseId() or an operator-selected active warehouse.
  // Null only for pre-32b orders (and a deployment with no default
  // warehouse) → resolveOrderStockWarehouseId's pre-32b compat fallback
  // applies. `SetNull` matches campaignId/createdById; the
  // InventoryMovement rows carry the authoritative per-movement warehouse.
  fulfillmentWarehouseId String?

  // The confirmation agent (confirmateur) credited with this order — see
  // docs/adr/0022-order-confirmation-commission.md. `SetNull` like
  // campaignId: removing an agent record must not touch order history, and
  // any commission already earned keeps its own snapshot on
  // CommissionEntry. Null for an unassigned order.
  confirmationAgentId String?

  createdById          String?
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy            User?                      @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  customer             Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fulfillmentWarehouse Warehouse?                 @relation("OrderFulfillmentWarehouse", fields: [fulfillmentWarehouseId], references: [id], onDelete: SetNull)
  confirmationAgent    CommissionAgent?           @relation(fields: [confirmationAgentId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  refunds              Refund[]
  shipments            Shipment[]
  movements            InventoryMovement[]
  commissionEntries    CommissionEntry[]
  confirmationAttempts OrderConfirmationAttempt[]
  campaign             MarketingCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId           String?

  // Prevents a duplicate Order under a genuine race between the order
  // webhook and a concurrent manual sync both importing the same
  // WooCommerce order for the first time (Postgres allows multiple NULLs
  // in a unique index, so this never restricts INTERNE orders, which all
  // have externalId=null). See docs/adr/0010-woocommerce-integration.md.
  // Phase 3 (docs/adr/0025) scopes this per tenant — two tenants can
  // independently import "the same" WooCommerce order id.
  @@unique([tenantId, source, externalId])
  @@unique([tenantId, displayNumber])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([placedAt])
  @@index([fulfillmentWarehouseId])
  @@index([confirmationAgentId])
  @@index([tenantId])
  @@index([status, lastConfirmationAttemptAt])
  @@map("orders")
}

/**
 * How a single confirmation-call attempt on an order turned out (docs/adr/
 * 0029). `CONFIRME` and `ANNULE` are terminal — they move the order to
 * CONFIRMEE / ANNULEE; the rest just log the attempt and leave the order
 * in the queue.
 */
enum OrderConfirmationOutcome {
  CONFIRME
  PAS_DE_REPONSE
  OCCUPE
  RAPPELER
  FAUX_NUMERO
  ANNULE
}

/**
 * Append-only log of confirmation-call attempts on an order — the "who
 * called, when, and how it went" trail behind the shared confirmation
 * queue (docs/adr/0029-order-confirmation-workflow.md). The denormalised
 * `Order.confirmationAttemptCount` / `lastConfirmationAttemptAt` are kept
 * in step by the action that writes here.
 */
model OrderConfirmationAttempt {
  id          String                   @id @default(cuid())
  tenantId    String                   @default("default")
  orderId     String
  agentUserId String?
  outcome     OrderConfirmationOutcome
  note        String?
  createdAt   DateTime                 @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent  User?  @relation("ConfirmationAttemptAgent", fields: [agentUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([agentUserId])
  @@index([tenantId])
  @@map("order_confirmation_attempts")
}

model OrderItem {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  orderId      String
  productId    String?
  variationId  String?
  nameSnapshot String
  skuSnapshot  String
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  // Product cost at time of sale — snapshotted so historical margin
  // calculations don't drift when a product's cost is edited later.
  costSnapshot Decimal? @db.Decimal(12, 2)

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([tenantId])
  @@map("order_items")
}

enum RefundStatus {
  EN_ATTENTE
  APPROUVE
  REJETE
  COMPLETE
}

model Refund {
  id            String       @id @default(cuid())
  tenantId      String       @default("default")
  orderId       String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String?
  status        RefundStatus @default(EN_ATTENTE)
  processedById String?
  // Set when this refund was imported alongside a WooCommerce order already
  // marked "refunded" there — see docs/adr/0010-woocommerce-integration.md.
  source        RecordSource @default(INTERNE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([tenantId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Order confirmation commission — see docs/adr/0022-order-confirmation-commission.md
//
// A confirmation agent (confirmateur) is credited a fixed amount per order
// they own, earned ONLY once the order reaches LIVREE. If a delivered
// order is later returned (LIVREE -> RETOUR) the earned amount is reversed
// with an opposite entry — the original entry is never mutated or deleted.
// `reconcileOrderCommission()` (src/lib/commissions.ts) is the single
// idempotent bridge between an order's status and its ledger; it runs
// under a per-order advisory lock so concurrent status updates can't
// double-credit.
// ---------------------------------------------------------------------------

// One row per User who acts as a confirmation agent, carrying their
// CURRENT rate. The rate in force at earn time is snapshotted onto each
// CommissionEntry, so changing it here never rewrites past earnings.
model CommissionAgent {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  userId       String   @unique
  ratePerOrder Decimal  @db.Decimal(10, 2)
  currency     String   @default("MAD") @db.Char(3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders     Order[]
  entries    CommissionEntry[]
  statements CommissionStatement[]

  @@index([tenantId])
  @@map("commission_agents")
}

enum CommissionEntryType {
  EARNED
  REVERSED
}

// Append-only ledger. EARNED = +rate when an order reaches LIVREE;
// REVERSED = -rate when a previously-earned order leaves LIVREE. Net
// commission for an order is the sum of its entries. `@@unique([orderId,
// type])` is the hard idempotency backstop on top of the advisory lock:
// at most one EARNED and one REVERSED per order (the order state machine
// has no path back to LIVREE, so re-earning can't happen).
model CommissionEntry {
  id          String              @id @default(cuid())
  tenantId    String              @default("default")
  agentId     String
  orderId     String
  type        CommissionEntryType
  amount      Decimal             @db.Decimal(10, 2)
  rateApplied Decimal             @db.Decimal(10, 2)
  currency    String              @default("MAD") @db.Char(3)
  note        String?
  // Set once the entry is locked into a closed monthly statement.
  statementId String?
  createdById String?
  createdAt   DateTime            @default(now())

  agent     CommissionAgent      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  order     Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  statement CommissionStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([agentId])
  @@index([statementId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("commission_entries")
}

enum CommissionStatementStatus {
  CLOTURE
  PAYE
}

// A closed monthly statement per agent. Created by the settlement action,
// which sweeps every not-yet-settled entry dated in that calendar month
// into it and freezes the totals. A reversal that lands after a month is
// closed simply falls into the next open period — standard practice.
model CommissionStatement {
  id             String                    @id @default(cuid())
  tenantId       String                    @default("default")
  agentId        String
  periodYear     Int
  periodMonth    Int
  status         CommissionStatementStatus @default(CLOTURE)
  earnedCount    Int                       @default(0)
  reversedCount  Int                       @default(0)
  earnedAmount   Decimal                   @default(0) @db.Decimal(12, 2)
  reversedAmount Decimal                   @default(0) @db.Decimal(12, 2)
  netAmount      Decimal                   @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal                   @default(0) @db.Decimal(12, 2)
  currency       String                    @default("MAD") @db.Char(3)
  note           String?
  closedById     String?
  closedAt       DateTime                  @default(now())
  paidById       String?
  paidAt         DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  agent    CommissionAgent   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closedBy User?             @relation("CommissionStatementClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  paidBy   User?             @relation("CommissionStatementPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  entries  CommissionEntry[]

  @@unique([agentId, periodYear, periodMonth])
  @@index([agentId])
  @@index([tenantId])
  @@map("commission_statements")
}

// ---------------------------------------------------------------------------
// Delivery — see docs/adr/0006-delivery-providers.md and
// docs/adr/0012-delivery-provider-integration.md (Phase 22)
// ---------------------------------------------------------------------------

enum ShippingProviderType {
  MANUEL
  FLOTTE_INTERNE
  API
}

model ShippingProvider {
  id       String               @id @default(cuid())
  tenantId String               @default("default")
  name     String
  type     ShippingProviderType @default(MANUEL)
  isActive Boolean              @default(true)
  // Non-secret adapter configuration only (e.g. default zones/rates, or for
  // an API provider, its non-secret settings such as account/warehouse id).
  config   Json?

  // --- API connector fields (Phase 22) — only meaningful when type = API.
  // See docs/adr/0012-delivery-provider-integration.md.
  // Which registered adapter (src/lib/integrations/delivery/registry.ts)
  // handles this row. Null for MANUEL/FLOTTE_INTERNE, and for an API
  // provider not yet fully configured.
  providerKey           String?
  // Mirrors IntegrationStatus's meaning exactly (see docs/adr/0010): saving
  // credentials never implies CONNECTE, only a real "Tester la connexion"
  // success does. Null (not DECONNECTE) for MANUEL/FLOTTE_INTERNE, whose
  // connection status is not applicable rather than "disconnected".
  connectionStatus      IntegrationStatus?
  // AES-256-GCM ciphertext (src/lib/crypto.ts, same mechanism as
  // Integration.credentialsEncrypted) — never returned to the client.
  credentialsEncrypted  String?
  // Capabilities the registered adapter reports supporting (see
  // DeliveryCapability) — lets the UI show only the actions this provider
  // instance genuinely supports instead of guessing from its type.
  capabilities          String[]           @default([])
  lastConnectionCheckAt DateTime?
  lastSyncAt            DateTime?
  lastError             String?

  // --- Merchant pricing rules for NON-successful outcomes (docs/adr/0032).
  // A successful delivery's price ALWAYS comes from the carrier's API for
  // an API provider — these two never touch it. `null` = not configured =
  // treated as 0 for that outcome. Deliberately NOT "same as delivery
  // cost" and NOT "a % of it" — an explicit amount the merchant sets.
  // Changing either is audited (shipping_provider.pricing_updated).
  returnCost  Decimal? @db.Decimal(12, 2)
  failureCost Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shipments     Shipment[]
  webhookEvents ShipmentWebhookEvent[]
  manifests     DeliveryManifest[]
  cityMappings  DeliveryCityMapping[]

  @@index([tenantId])
  @@map("shipping_providers")
}

// A persistent, provider-agnostic override that pins one local ASODITECH
// city to a specific delivery provider's own city identifier — see
// docs/adr/0018-delivery-city-mapping.md. The core problem: a local order
// says "Casablanca" but a carrier's catalogue may spell it differently, or
// carry several near-identical entries, and every carrier uses its own id
// scheme. The system must never guess, so when the safe automatic match is
// ambiguous or finds nothing, an operator records the exact provider city
// here and shipment creation uses it verbatim.
//
// Nothing here is carrier-specific: `providerCityId` holds whatever string
// the provider documents as its identifier (a number is stored as its
// string form), and `providerCityName` is kept only for display / audit.
// One mapping belongs to exactly one ShippingProvider; the same local city
// can map differently for every provider. `onDelete: Cascade` because a
// mapping is pure per-provider configuration (like credentials), not
// history — deleting the provider discards it.
model DeliveryCityMapping {
  id                 String   @id @default(cuid())
  tenantId           String   @default("default")
  shippingProviderId String
  // The local city, normalized with the shared normalizeCityName() rules
  // (lower-cased, accent-stripped, whitespace-collapsed) — the lookup key.
  localCityKey       String
  // The local city exactly as the operator entered / saw it when creating
  // the mapping. Display and audit only, never matched against.
  localCityLabel     String
  // The provider's own city identifier, stored verbatim as supplied. Never
  // parsed, never assumed numeric.
  providerCityId     String
  // The provider's own display name for that city, from its catalogue.
  providerCityName   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  provider ShippingProvider @relation(fields: [shippingProviderId], references: [id], onDelete: Cascade)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // At most one mapping per (provider, local city) — the DB is the real
  // guard against a duplicate created by two concurrent requests.
  @@unique([shippingProviderId, localCityKey])
  @@index([shippingProviderId])
  @@index([tenantId])
  @@map("delivery_city_mappings")
}

enum ShipmentStatus {
  EN_ATTENTE
  EN_TRANSIT
  LIVRE
  ECHEC
  RETOURNE
  ANNULE
}

/**
 * Where `Shipment.cost` came from — see docs/adr/0032-delivery-cost-rules.md.
 * For a successful delivery the carrier's API is the ONLY source of truth
 * (`CARRIER_API`); ASODITECH never invents a delivery price. Return and
 * failure outcomes use the merchant's own configured rules on the
 * provider (`RETURN_RULE` / `FAILURE_RULE`). `MANUAL_OVERRIDE` is an
 * explicit, permission-gated, audited accounting correction — never an
 * automatic fallback when the carrier API fails.
 */
enum ShipmentCostSource {
  CARRIER_API
  RETURN_RULE
  FAILURE_RULE
  MANUAL_OVERRIDE
}

model Shipment {
  id              String              @id @default(cuid())
  tenantId        String              @default("default")
  orderId         String
  providerId      String
  trackingNumber  String?
  trackingUrl     String?
  status          ShipmentStatus      @default(EN_ATTENTE)
  // The delivery cost for this shipment. While in flight this holds the
  // carrier's pre-delivery estimate (from its own pricing API/catalogue,
  // never an ASODITECH guess); it is FROZEN — `costFinalizedAt` set — the
  // moment the shipment reaches a financially final state (delivered →
  // carrier price, returned → provider.returnCost, failed → provider.
  // failureCost). Null means "unknown" — the carrier API gave no price —
  // never a placeholder. Finance reads this stored value, so changing a
  // provider's rules later never rewrites historical shipment costs.
  cost            Decimal?            @db.Decimal(12, 2)
  costSource      ShipmentCostSource?
  costFinalizedAt DateTime?
  failedReason    String?
  notes           String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // --- API connector fields (Phase 22), see
  // docs/adr/0012-delivery-provider-integration.md. All null for shipments
  // created against a MANUEL/FLOTTE_INTERNE provider.
  // The provider's own shipment id, returned by createShipment — never
  // fabricated. Unique per provider so a duplicate create request (retry,
  // concurrent submit) can never attach two local rows to the same
  // external shipment.
  externalId        String?
  // The provider's raw status string as last observed, preserved verbatim
  // even when it doesn't map to a known local ShipmentStatus — see
  // mapProviderStatus in the delivery integration layer. Never guessed.
  providerStatusRaw String?
  // Last time this shipment's status was actually fetched from the
  // provider (manual "Synchroniser" action) — distinct from updatedAt,
  // which also changes on a staff-entered manual status change.
  lastSyncedAt      DateTime?

  // --- « Suivi » module (docs/adr/0033-tracking-module.md). Additive,
  // all-nullable, populated only by the NEW /livraison/suivi refresh flow
  // via the adapter's optional FETCH_TRACKING capability. NOTHING in the
  // existing delivery / status-sync / cost / invoice paths reads or writes
  // these — the old tracking is untouched.
  //   trackingEvents     — normalized carrier event history as last synced,
  //                        an array of { rawStatus, code, label, description,
  //                        location, timestamp }. Never fabricated; empty
  //                        when the carrier gives none.
  //   courierName/Phone  — the delivery person, IF the carrier API reports
  //                        one (neither current carrier does today).
  //   lastTrackingSyncAt — rate-limit / "il y a 2 min" anchor.
  //   trackingSyncError  — last FETCH_TRACKING failure message; the events
  //                        above are kept as the last-known-good.
  trackingEvents     Json?
  courierName        String?
  courierPhone       String?
  lastTrackingSyncAt DateTime?
  trackingSyncError  String?

  // The delivery manifest (Bon de Livraison) this parcel was handed over
  // on, if any — see docs/adr/0015-delivery-manifest.md. Set once, when a
  // manifest is generated for a batch of EN_ATTENTE API shipments; a
  // shipment is on at most one manifest. `SetNull` only so a manifest row
  // could be removed in an admin cleanup without cascading the shipments;
  // no code path deletes manifests.
  manifestId String?

  updatedById String?
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider    ShippingProvider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  updatedBy   User?             @relation("ShipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  manifest    DeliveryManifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  // Postgres allows multiple NULLs in a unique index, so this never
  // restricts MANUEL/FLOTTE_INTERNE shipments (externalId always null).
  // See docs/adr/0010-woocommerce-integration.md's identical Order pattern.
  @@unique([providerId, externalId])
  @@index([orderId])
  @@index([providerId])
  @@index([status])
  @@index([manifestId])
  @@index([tenantId])
  @@map("shipments")
}

enum DeliveryManifestStatus {
  // Local row created, at least one carrier step not yet confirmed.
  BROUILLON
  // The carrier confirmed the whole batch (save-delivery-note succeeded)
  // — the parcels are handed over, printable documents are available.
  FINALISE
  // A carrier step failed. No shipment is linked; the operator can retry
  // with a fresh manifest.
  ECHEC
}

// A carrier "delivery note" / manifest / bordereau — one handover document
// grouping several API-created shipments of the SAME provider so the
// operator can print it (plus parcel labels) and hand the batch to the
// carrier in one go. See docs/adr/0015-delivery-manifest.md. Only carriers
// whose adapter declares the GENERATE_MANIFEST capability can produce one.
model DeliveryManifest {
  id           String                 @id @default(cuid())
  tenantId     String                 @default("default")
  providerId   String
  // The carrier's own manifest reference (e.g. OzonExpress "BL240115001").
  // Null only while BROUILLON/ECHEC before the carrier returned one —
  // never fabricated.
  externalRef  String?
  status       DeliveryManifestStatus @default(BROUILLON)
  parcelCount  Int                    @default(0)
  // [{ label, url }] — printable-document links the carrier documents for
  // this manifest reference (the bordereau PDF, A4 label sheet, …). Opened
  // by the operator in their browser; NEVER fetched or proxied
  // server-side (the carrier portal owns rendering and its own auth). `[]`
  // when the carrier exposes none.
  documents    Json                   @default("[]")
  failedReason String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  createdById  String?

  provider  ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("ManifestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  shipments Shipment[]

  @@index([providerId])
  @@index([tenantId])
  @@map("delivery_manifests")
}

// Minimal, replay-protected record of processed delivery-provider webhook
// deliveries — mirrors WebhookEvent's shape and guarantees exactly, but
// scoped to ShippingProvider instead of Integration (delivery providers are
// deliberately not modeled as an Integration row — see
// docs/adr/0006-delivery-providers.md and
// docs/adr/0012-delivery-provider-integration.md). No raw payload is ever
// persisted — only id/topic/resource id/outcome.
model ShipmentWebhookEvent {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  providerId String
  deliveryId String
  topic      String
  resourceId String?
  status     String
  receivedAt DateTime @default(now())

  provider ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([providerId, deliveryId])
  @@index([providerId, topic])
  @@index([tenantId])
  @@map("shipment_webhook_events")
}

// ---------------------------------------------------------------------------
// Finance — see docs/adr/0007-finance-and-profit.md
// Revenue is derived from Order data, never stored as its own ledger.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id       String  @id @default(cuid())
  tenantId String  @default("default")
  name     String
  isSystem Boolean @default(false)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  expenses Expense[]

  // Phase 3 (docs/adr/0025): name is unique per tenant, not globally.
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  categoryId   String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("MAD") @db.Char(3)
  date         DateTime
  description  String?
  vendor       String?
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordedBy User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([date])
  @@index([tenantId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Marketing — see docs/adr/0008-marketing-and-attribution.md
// ---------------------------------------------------------------------------

enum MarketingChannelType {
  META
  GOOGLE
  TIKTOK
  AUTRE
}

model MarketingChannel {
  id       String               @id @default(cuid())
  tenantId String               @default("default")
  name     String
  type     MarketingChannelType @default(AUTRE)
  isActive Boolean              @default(true)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campaigns MarketingCampaign[]

  @@index([tenantId])
  @@map("marketing_channels")
}

enum CampaignStatus {
  BROUILLON
  ACTIVE
  EN_PAUSE
  TERMINEE
}

model MarketingCampaign {
  id        String         @id @default(cuid())
  tenantId  String         @default("default")
  channelId String
  name      String
  startDate DateTime
  endDate   DateTime?
  budget    Decimal?       @db.Decimal(12, 2)
  spend     Decimal?       @db.Decimal(12, 2)
  status    CampaignStatus @default(BROUILLON)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  channel MarketingChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders  Order[]

  @@index([channelId])
  @@index([tenantId])
  @@map("marketing_campaigns")
}

// ---------------------------------------------------------------------------
// Integrations — see docs/adr/0004-integration-architecture.md
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  WOOCOMMERCE
  SHOPIFY
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  WHATSAPP
  EMAIL
  GOOGLE_SHEETS
  AI_PROVIDER
}

// DECONNECTE: never configured, or explicitly disconnected.
// CONFIGURE: credentials saved but never (or not yet) verified by a real
//   authenticated request — this is deliberately distinct from CONNECTE so
//   the UI never claims a live connection merely because credentials exist.
//   Added during Phase 20 (WooCommerce integration); see
//   docs/adr/0004-integration-architecture.md's audit addendum and
//   docs/adr/0010-woocommerce-integration.md.
// CONNECTE: the most recent connection test actually succeeded.
// ERREUR: the most recent connection test or sync attempt failed.
enum IntegrationStatus {
  DECONNECTE
  CONFIGURE
  CONNECTE
  ERREUR
}

model Integration {
  id                    String              @id @default(cuid())
  tenantId              String              @default("default")
  provider              IntegrationProvider
  status                IntegrationStatus   @default(DECONNECTE)
  // Non-secret configuration (store URLs, sync direction, flags, etc.)
  config                Json?
  // AES-256-GCM ciphertext (src/lib/crypto.ts) — never returned to the
  // frontend as plaintext, never logged. For WooCommerce this decrypts to
  // { consumerKey, consumerSecret, webhookSecret }.
  credentialsEncrypted  String?
  capabilities          String[]            @default([])
  lastSyncAt            DateTime?
  // Set only when a "Tester la connexion" request actually succeeded —
  // distinct from lastSyncAt, which covers data synchronization runs.
  lastConnectionCheckAt DateTime?
  lastError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  syncRuns      SyncRun[]
  webhookEvents WebhookEvent[]

  // Phase 3 (docs/adr/0025): provider is unique per tenant, not globally —
  // two tenants can each connect their own WooCommerce store. Webhooks
  // disambiguate by trying every candidate's signature (see
  // src/app/api/webhooks/{woocommerce,shopify}/route.ts).
  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integrations")
}

enum SyncDirection {
  IMPORT
  EXPORT
  BIDIRECTIONNEL
}

enum SyncRunStatus {
  EN_COURS
  SUCCES
  ECHEC
  PARTIEL
}

// One row per synchronization run, scoped to a single resource (e.g.
// "PRODUCTS", "ORDERS", "STOCK_PUSH") rather than "everything" — so the
// per-resource sync direction and honest per-item result breakdown (see
// docs/adr/0010-woocommerce-integration.md) stay legible per run instead of
// blurring together.
model SyncRun {
  id             String        @id @default(cuid())
  tenantId       String        @default("default")
  integrationId  String
  resource       String
  direction      SyncDirection
  status         SyncRunStatus @default(EN_COURS)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  itemsImported  Int           @default(0)
  itemsUpdated   Int           @default(0)
  itemsUnchanged Int           @default(0)
  itemsSkipped   Int           @default(0)
  itemsProcessed Int           @default(0)
  itemsFailed    Int           @default(0)
  errorSummary   String?
  triggeredById  String?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  triggeredBy User?       @relation("SyncRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([resource])
  @@index([triggeredById])
  @@index([tenantId])
  @@map("sync_runs")
}

// Minimal, replay-protected record of processed webhook deliveries — no
// raw external payload is ever persisted (see
// docs/adr/0010-woocommerce-integration.md). `deliveryId` is the
// provider's own per-delivery id (WooCommerce: X-WC-Webhook-Delivery-ID),
// unique per (integration, deliveryId) so a captured-and-replayed request
// is rejected rather than reprocessed.
model WebhookEvent {
  id            String              @id @default(cuid())
  tenantId      String              @default("default")
  integrationId String
  provider      IntegrationProvider
  deliveryId    String
  topic         String
  resourceId    String?
  status        String
  receivedAt    DateTime            @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([integrationId, deliveryId])
  @@index([integrationId, topic])
  @@index([tenantId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  STOCK_FAIBLE
  RUPTURE_STOCK
  NOUVELLE_COMMANDE
  ECHEC_LIVRAISON
  COMMANDE_RETOURNEE
  PROBLEME_PAIEMENT
  ERREUR_INTEGRATION
  ECHEC_SYNCHRONISATION
}

// Per-user, in-app alert about a business event the recipient is
// permitted to see. Created (never edited beyond isRead) by
// src/lib/notifications.ts's `notify()`, which fans one event out to
// every ACTIVE user holding the event's permission. See
// docs/adr/0016-notifications.md.
model Notification {
  id         String           @id @default(cuid())
  tenantId   String           @default("default")
  userId     String
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  // Idempotency key for an event-driven notification, of the form
  // `<event>:<entityId>[:<bucket>]` (a recurring-condition alert like low
  // stock adds a per-day bucket; a one-shot event like "order created"
  // does not). `@@unique([userId, dedupeKey])` — Postgres allows multiple
  // NULLs, so a keyless ad-hoc notification is never restricted — makes
  // fan-out via `createMany({ skipDuplicates: true })` concurrency-safe
  // without an app-level lock. See docs/adr/0016-notifications.md.
  dedupeKey  String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([tenantId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Settings — singleton row
// ---------------------------------------------------------------------------

// Phase 1 made this a global singleton (`id = "singleton"`); Phase 3
// (docs/adr/0025) makes it tenant-scoped instead — one settings row per
// tenant, looked up/created by `tenantId`. The bootstrap tenant's existing
// row keeps its literal id "singleton" (never rewritten); every row
// created from here on gets a normal cuid() id, and `tenantId` — not
// `id` — is the lookup key everywhere (src/actions/settings.ts,
// src/app/(protected)/parametres/page.tsx).
model BusinessSettings {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique @default("default")
  companyName              String   @default("")
  currency                 String   @default("MAD") @db.Char(3)
  address                  String?
  city                     String?
  country                  String   @default("Maroc")
  phone                    String?
  email                    String?
  logoUrl                  String?
  timezone                 String   @default("Africa/Casablanca")
  locale                   String   @default("fr")
  lowStockDefaultThreshold Int      @default(5)
  orderNumberPrefix        String   @default("CMD")
  updatedAt                DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("business_settings")
}

// ---------------------------------------------------------------------------
// Audit log — append-only, generic. See docs/adr/0003-auth-and-rbac.md.
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  INTEGRATION
}

model AuditEvent {
  id            String         @id @default(cuid())
  tenantId      String         @default("default")
  actorType     AuditActorType
  actorUserId   String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  actorUser User?  @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
  @@index([tenantId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Backup & Portability — Phase 1 (docs/adr/0034-backup-and-portability.md).
//
// An INDEPENDENT module: a tenant can export ONLY their own business data
// as a versioned, authenticated-encrypted `.asb` package, download it, and
// restore it. Nothing here changes Orders / Stock / Delivery / Finance /
// RBAC / multi-tenant behaviour. This table is the ONLY schema addition.
//
// `payload` holds the sealed container bytes so a generated backup can be
// re-downloaded and so the mandatory pre-restore safety snapshot is a real,
// retrievable artifact. It is NEVER itself included in any backup. Rows are
// pruned aggressively (see src/lib/backup/*): superseded MANUAL_EXPORT and
// consumed RESTORE_UPLOAD payloads are nulled; PRE_RESTORE_SNAPSHOT rows
// carry an `expiresAt`.
// ---------------------------------------------------------------------------

enum BackupRunType {
  // A backup the tenant generated on demand ("Sauvegarder maintenant").
  MANUAL_EXPORT
  // Auto-generated snapshot of the tenant's current data taken immediately
  // BEFORE a restore, so a bad restore is always recoverable.
  PRE_RESTORE_SNAPSHOT
  // A package uploaded by the tenant, validated and held server-side
  // between the restore "preview" and "confirm" steps.
  RESTORE_UPLOAD
}

enum BackupRunStatus {
  PENDING
  READY
  RESTORED
  FAILED
  EXPIRED
}

model BackupRun {
  id             String          @id @default(cuid())
  tenantId       String          @default("default")
  type           BackupRunType
  status         BackupRunStatus @default(PENDING)
  // The ASODITECH backup FORMAT version (src/lib/backup/constants.ts),
  // independent of appVersion / schemaVersion below.
  formatVersion  Int
  appVersion     String
  // The latest applied DB migration at creation time — best-effort, for
  // diagnostics and future cross-deployment compatibility checks.
  schemaVersion  String
  // Per-model row counts { "products": 0, "orders": 0, … }.
  counts         Json
  sizeBytes      Int             @default(0)
  checksumSha256 String          @default("")
  // Sealed `.asb` container (AES-256-GCM). Nulled once superseded/consumed.
  payload        Bytes?
  error          String?
  note           String?
  createdById    String?
  createdAt      DateTime        @default(now())
  // Set on RESTORE_UPLOAD / PRE_RESTORE_SNAPSHOT rows — retained only briefly.
  expiresAt      DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("BackupRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, type, createdAt])
  @@index([tenantId])
  @@map("backup_runs")
}

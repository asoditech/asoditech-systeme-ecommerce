# In production this MUST be the restricted, non-superuser, NOBYPASSRLS
# runtime role (see scripts/provision-production-role.sql and
# docs/adr/0026-multi-tenant-rls.md) — RLS enforces nothing for a
# superuser or the table owner. Append `?pgbouncer=true` when this points
# at PgBouncer/Supavisor in transaction-pooling mode (e.g. Supabase's
# pooled port 6543) — required so Prisma disables prepared statements,
# which don't survive that pooling mode.
DATABASE_URL="postgresql://user:password@localhost:5432/asoditech_ecommerce?schema=public"

# Prisma Migrate uses DIRECT_URL (unpooled) to run DDL. Locally this can be
# identical to DATABASE_URL. In production this must be the DATABASE
# OWNER/admin role (never the restricted runtime role above — it can't
# run DDL), on the direct/unpooled connection (e.g. Supabase port 5432,
# not 6543) — see docs/adr/0001-tech-stack.md.
DIRECT_URL="postgresql://user:password@localhost:5432/asoditech_ecommerce?schema=public"

# Pepper mixed into session-token hashing. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# 32-byte key (base64) used to encrypt integration credentials at rest
# (src/lib/crypto.ts). Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY="change-me"

# Canonical base URL for this deployment, used to build absolute links in
# transactional emails (src/lib/email.ts) — a queued email has no request
# to derive it from. In production, use the real domain, never a
# *.vercel.app preview URL.
APP_URL="http://localhost:3000"

# Transactional email (invitations, password reset — src/lib/email.ts).
# Both optional: when either is unset, emails are logged instead of sent
# (safe default for local dev/CI). Get an API key at https://resend.com;
# EMAIL_FROM must be a verified sender on that Resend account, e.g.
# "ASODITECH <noreply@yourdomain.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

NODE_ENV="development"
